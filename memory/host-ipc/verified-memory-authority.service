[Unit]
Description=REVREBEL verified-memory root authority (operator activation only)
After=postgresql.service agent-bridge.service
RequiresMountsFor=/var/lib/bridge-memory-authority /var/lib/bridge-memory-authority-code

[Service]
Type=simple
User=root
Group=bridge
UMask=0077
WorkingDirectory=/var/lib/bridge-memory-authority-code
ExecStart=/usr/bin/python3 /var/lib/bridge-memory-authority-code/memory/host-ipc/authority-server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bridge-memory-authority /run/bridge-memory-authority
RuntimeDirectory=bridge-memory-authority
RuntimeDirectoryMode=0750
PrivateDevices=yes
LockPersonality=yes
RestrictNamespaces=yes
# Canonical Bridge ledger entries are mode 0600 owned by the bridge uid.
# Permit DAC read/search only, not CAP_DAC_OVERRIDE or file modification.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target

# REVREBEL /opt Infrastructure Monorepo
# Ignore everything unless explicitly included.

# Ignore all top-level files and directories
/*

# Include repository configuration
!/.gitignore
!/README.md
!/.gitattributes

# Include the entire scripts directory
!/scripts/

# Preserve these directories as placeholders
!/agents/
!/agent-tools/
!/global-tools/

# Ignore their contents
/agents/*
/agent-tools/*
/global-tools/*

# Track only placeholder files
!/agents/.gitkeep
!/agent-tools/.gitkeep
!/global-tools/.gitkeep

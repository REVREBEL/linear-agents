# REVREBEL /opt Infrastructure Monorepo
# Ignore everything unless explicitly included.

# 1. Ignore all top-level files and directories
/*

# 2. Include repository configuration
!/.gitignore
!/README.md
!/.gitattributes

# 3. Include the entire scripts directory
!/scripts/

# 4. Agents: allow any subfolder, ignore contents except README.md & .gitkeep
!/agents/
/agents/*
!/agents/*/
/agents/*/*
!/agents/.gitkeep
!/agents/README.md
!/agents/*/.gitkeep
!/agents/*/README.md

# 5. Agent Tools: ignore contents except README.md & .gitkeep
!/agent-tools/
/agent-tools/*
!/agent-tools/.gitkeep
!/agent-tools/README.md

# 6. Global Tools: allow any subfolder, ignore contents except README.md & .gitkeep
!/global-tools/
/global-tools/*
!/global-tools/*/
/global-tools/*/*
!/global-tools/.gitkeep
!/global-tools/README.md
!/global-tools/*/.gitkeep
!/global-tools/*/README.md
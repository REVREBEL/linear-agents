{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "linear-mock-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "LINEAR_DATA",
      "id": "CONFIGURED_FROM_ENV"
    }
  ],
  "vars": {
    "SERVICE_NAME": "linear-mock-agent",
    "LINEAR_REDIRECT_URI": "https://linear-mock.yourdomain.com/oauth/callback",
    "LINEAR_SCOPES": "read,write,app:assignable,app:mentionable",
    "BRIDGE_URL": "https://mock-agent.yourdomain.com/jobs"
  }
}

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "linear-mock-agent",
  "main": "src/index.ts",
  "routes": [{ "pattern": "linear-${MOCK_PREFIX}.${DOMAIN}", "custom_domain": true }],
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "LINEAR_DATA",
      "id": "${MOCK_KV_NAMESPACE_ID}"
    }
  ],
  "vars": {
    "SERVICE_NAME": "linear-${MOCK_PREFIX}-agent",
    "LINEAR_REDIRECT_URI": "https://linear-${MOCK_PREFIX}.${DOMAIN}/oauth/callback",
    "LINEAR_SCOPES": "read,write,app:assignable,app:mentionable",
    "BRIDGE_URL": "https://${MOCK_PREFIX}-agent.${DOMAIN}/jobs"
  }
}

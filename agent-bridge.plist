<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ENTER DOMAIN.agent-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ENTER LOCAL USER/ENTER PATH TO INSTALL LOCATION/linear-agents/scripts/with-env.sh</string>
        <string>bridge</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/ENTER LOCAL USER/.linear-agent-bridge/</string>

    <key>StandardOutPath</key>
    <string>/Users/ENTER LOCAL USER/.linear-agent-bridge/bridge.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ENTER LOCAL USER/.linear-agent-bridge/bridge-error.log</string>
  </dict>
</plist>

##############################################################################
# Central local configuration for Linear-agents.
# Copy to .env and fill values. Never commit .env.
# Shell-compatible assignments: quote values containing spaces or shell metacharacters.
##############################################################################


##############################################################################
# SYSTEM / SETUP
##############################################################################

PATH="${HOME}/.nvm/current/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"#
# PROJECTS_ROOT="${HOME}/rebel"
OSX_PROJECTS_ROOT="${HOME}"
# LINUX_PROJECTS_ROOT="/home/rebel"
DOMAIN="domain.io"
GLOBAL_PREFIX_NAME=agent

# Same shared secret must be used by the Mac bridge and all four Workers.

BRIDGE_SHARED_SECRET="" 
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8788
LINEAR_API_KEY=											# Optional: API key for Linear MCP authentication (configure per agent as needed).
GOOGLE_CLOUD_PROJECT=									# LINEAR APP OAUTH: each Worker is its own Linear app installation

PYTHON_BIN="${OSX_PROJECTS_ROOT}/linear-agents/linear-agent-bridge/.venv/bin/python"
RUN_AGENT_PATH="${OSX_PROJECTS_ROOT}/linear-agents/linear-agent-bridge/run_agent.py"

##############################################################################
# CLOUDFLARE / TERRAFORM
##############################################################################

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_LINEAR_IP_LIST_ID=							# Existing resources; IDs are needed for later Terraform imports.
CLOUDFLARE_WAF_CUSTOM_RULESET_ID=


##############################################################################
# ANTIGRAVITY
##############################################################################

ANTIGRAVITY_PREFIX=antigravity
ANTIGRAVITY_HOST="${ANTIGRAVITY_PREFIX}-agent.${DOMAIN}"
ANTIGRAVITY_LINEAR_CLIENT_ID=
ANTIGRAVITY_LINEAR_CLIENT_SECRET=
ANTIGRAVITY_WEBHOOK_URL="https://linear-${ANTIGRAVITY_PREFIX}.${DOMAIN}/webhook"
ANTIGRAVITY_LINEAR_WEBHOOK_SECRET=
ANTIGRAVITY_BIN="${HOME}/.local/bin/agy"
ANTIGRAVITY_PRINT_TIMEOUT=30m
ANTIGRAVITY_KV_NAMESPACE_ID=""
ANTIGRAVITY_GITHUB_APP_NAME="${GLOBAL_PREFIX_NAME}-${ANTIGRAVITY_PREFIX}"
ANTIGRAVITY_GITHUB_APP_ID=""
ANTIGRAVITY_GITHUB_CLIENT_ID=""
ANTIGRAVITY_GITHUB_SECRET=""                             # GitHub App webhook signing secret; deployed as Cloudflare GITHUB_WEBHOOK_SECRET
ANTIGRAVITY_GITHUB_WEBHOOK="https://github-${ANTIGRAVITY_PREFIX}.${DOMAIN}/webhook"
ANTIGRAVITY_GITHUB_CALLBACK="https://github-${ANTIGRAVITY_PREFIX}.${DOMAIN}/oauth/callback"
ANTIGRAVITY_GITHUB_APP_KEY_PATH=".gemini/credentials/github-private-key.pem"
ANTIGRAVITY_MODE="cli"						          # ANTIGRAVITY_MODE="desktop" | "cli"
ANTIGRAVITY_ISSUE_RECOVERY_ENABLED=true			# Antigravity issue-level conversation recovery

##############################################################################
# GEMINI
##############################################################################

GEMINI_PREFIX=gemini
GEMINI_HOST="${GEMINI_PREFIX}-agent.${DOMAIN}"
GEMINI_LINEAR_CLIENT_ID=
GEMINI_LINEAR_CLIENT_SECRET=
GEMINI_WEBHOOK_URL="https://linear-${GEMINI_PREFIX}.${DOMAIN}/webhook"
GEMINI_LINEAR_WEBHOOK_SECRET=
GEMINI_ARGS_TEMPLATE="-p {{PROMPT}} --approval-mode auto_edit --skip-trust"
GEMINI_BIN="${HOME}/.nvm/current/bin/gemini"
GEMINI_LAUNCH_MODE=warp
GEMINI_KV_NAMESPACE_ID=
GEMINI_GITHUB_APP_NAME="${GLOBAL_PREFIX_NAME}-${GEMINI_PREFIX}"
GEMINI_GITHUB_APP_ID=""
GEMINI_GITHUB_CLIENT_ID=""
GEMINI_GITHUB_SECRET=""                             # GitHub App webhook signing secret; deployed as Cloudflare GITHUB_WEBHOOK_SECRET
GEMINI_GITHUB_WEBHOOK="https://github-${GEMINI_PREFIX}.${DOMAIN}/webhook"
GEMINI_GITHUB_CALLBACK=https://github-${GEMINI_PREFIX}.${DOMAIN}/oauth/callback


##############################################################################
# TRAE
##############################################################################

TRAE_PREFIX=trae
TRAE_HOST="${TRAE_PREFIX}-agent.${DOMAIN}"
TRAE_LINEAR_CLIENT_ID=
TRAE_LINEAR_CLIENT_SECRET=
TRAE_WEBHOOK_URL="https://linear-${TRAE_PREFIX}.${DOMAIN}/webhook"
TRAE_LINEAR_WEBHOOK_SECRET=
TRAE_ARGS_TEMPLATE="chat --reuse-window --maximize {{PROMPT}}"
TRAE_BIN=/usr/local/bin/trae
TRAE_KV_NAMESPACE_ID=
TRAE_GITHUB_APP_NAME="${GLOBAL_PREFIX_NAME}-${TRAE_PREFIX}"
TRAE_GITHUB_APP_ID=""
TRAE_GITHUB_CLIENT_ID=""
TRAE_GITHUB_SECRET=""                             # GitHub App webhook signing secret; deployed as Cloudflare GITHUB_WEBHOOK_SECRET
TRAE_GITHUB_WEBHOOK="https://github-${TRAE_PREFIX}.${DOMAIN}/webhook"
TRAE_GITHUB_CALLBACK=https://github-${TRAE_PREFIX}.${DOMAIN}/oauth/callback


##############################################################################
# CHATGPT
##############################################################################

CHATGPT_PREFIX=chatgpt
CHATGPT_HOST="${CHATGPT_PREFIX}-agent.${DOMAIN}"
CHATGPT_LINEAR_CLIENT_ID=
CHATGPT_LINEAR_CLIENT_SECRET=
CHATGPT_WEBHOOK_URL="https://linear-${CHATGPT_PREFIX}.${DOMAIN}/webhook"
CHATGPT_LINEAR_WEBHOOK_SECRET=
CHATGPT_KV_NAMESPACE_ID=
CHATGPT_HANDOFF_MODE=supervised-playwright				# "supervised-playwright" or "shortcuts"
CHATGPT_SHORTCUT_NAME="Linear ChatGPT Handoff"			# Used only when CHATGPT_HANDOFF_MODE=shortcuts
CHATGPT_GITHUB_APP_NAME="${GLOBAL_PREFIX_NAME}-${CHATGPT_PREFIX}"
CHATGPT_GITHUB_APP_ID=""
CHATGPT_GITHUB_CLIENT_ID=""
CHATGPT_GITHUB_SECRET=""
CHATGPT_GITHUB_WEBHOOK="https://github-${CHATGPT_PREFIX}.${DOMAIN}/webhook"
CHATGPT_GITHUB_CALLBACK="https://github-${CHATGPT_PREFIX}.${DOMAIN}/oauth/callback"
CHATGPT_HANDOFF_CALLBACK_TOKEN=""

CHATGPT_CLI_KV_NAMESPACE_ID="1ca85a0e05784e64bbd450aa3b338fe1"

##############################################################################
# MOCK
##############################################################################

MOCK_PREFIX=mock
MOCK_HOST="${MOCK_PREFIX}-agent.${DOMAIN}"
MOCK_LINEAR_CLIENT_ID=""
MOCK_LINEAR_CLIENT_SECRET=""
MOCK_WEBHOOK_URL="https://linear-${MOCK_PREFIX}.${DOMAIN}/webhook"
MOCK_LINEAR_WEBHOOK_SECRET=""
MOCK_ARGS_TEMPLATE="chat --reuse-window --maximize {{PROMPT}}"
MOCK_KV_NAMESPACE_ID=""
MOCK_GITHUB_APP_NAME="${GLOBAL_PREFIX_NAME}-${MOCK_PREFIX}"
MOCK_GITHUB_APP_ID=""
MOCK_GITHUB_CLIENT_ID=""
MOCK_GITHUB_SECRET=""                             # GitHub App webhook signing secret; deployed as Cloudflare GITHUB_WEBHOOK_SECRET
MOCK_GITHUB_WEBHOOK="https://github-${MOCK_PREFIX}.${DOMAIN}/webhook"
MOCK_GITHUB_CALLBACK="https://github-${MOCK_PREFIX}.${DOMAIN}/oauth/callback"

##############################################################################
# GEMMA
##############################################################################

GEMMA_PREFIX=gemma
GEMMA_HOST="${GEMMA_PREFIX}-agent.${DOMAIN}"
GEMMA_LINEAR_CLIENT_ID=""
GEMMA_LINEAR_CLIENT_SECRET=""
GEMMA_WEBHOOK_URL="https://linear-${GEMMA_PREFIX}.${DOMAIN}/webhook"
GEMMA_LINEAR_WEBHOOK_SECRET=""
GEMMA_ARGS_TEMPLATE="chat --reuse-window --maximize {{PROMPT}}"
GEMMA_GITHUB_APP_NAME="${GLOBAL_PREFIX_NAME}-${GEMMA_PREFIX}"
GEMMA_GITHUB_APP_ID=""
GEMMA_GITHUB_CLIENT_ID=""
GEMMA_GITHUB_SECRET=""
GEMMA_GITHUB_WEBHOOK="https://github-${GEMMA_PREFIX}.${DOMAIN}/webhook"
GEMMA_GITHUB_CALLBACK="https://github-${GEMMA_PREFIX}.${DOMAIN}/oauth/callback"
GEMMA_PROVIDER="litellm"
GEMMA_LITELLM_BASE_URL="http://127.0.0.1:4000/v1"
GEMMA_LITELLM_MODEL="gemma-coding"
GEMMA_KV_NAMESPACE_ID=""

OPENROUTER_DEFAULT_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_MAX_STEPS=8
OPENROUTER_TIMEOUT_MS=300000

MAC_SSH_HOST="macos"



# Central local configuration for Linear-agents.
# Copy to .env and fill values. Never commit .env.
# Shell-compatible assignments: quote values containing spaces or shell metacharacters.

# SYSTEM / SETUP
PATH="${HOME}/.nvm/current/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
PROJECTS_ROOT=
DOMAIN=

# Same shared secret must be used by the Mac bridge and all five Workers.
# MAC BRIDGE (use absolute paths where possible)
BRIDGE_SHARED_SECRET=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8788

# Optional: API key for Linear MCP authentication (configure per agent as needed).
# LINEAR_API_KEY=

# CLOUDFLARE / TERRAFORM
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Existing resources; IDs are needed for later Terraform imports.
CLOUDFLARE_LINEAR_IP_LIST_ID=
CLOUDFLARE_WAF_CUSTOM_RULESET_ID=

# LINEAR APP OAUTH: each Worker is its own Linear app installation
GOOGLE_CLOUD_PROJECT=

ANTIGRAVITY_PREFIX=antigravity
ANTIGRAVITY_HOST="${ANTIGRAVITY_PREFIX}-agent.${DOMAIN}"
ANTIGRAVITY_LINEAR_CLIENT_ID=
ANTIGRAVITY_LINEAR_CLIENT_SECRET=
ANTIGRAVITY_WEBHOOK_URL="https://linear-${ANTIGRAVITY_PREFIX}.${DOMAIN}/webhook"
ANTIGRAVITY_LINEAR_WEBHOOK_SECRET=
ANTIGRAVITY_BIN="${HOME}/.local/bin/agy"
ANTIGRAVITY_PRINT_TIMEOUT=30m
ANTIGRAVITY_KV_NAMESPACE_ID=

GEMINI_PREFIX=gemini
GEMINI_HOST="${GEMINI_PREFIX}-agent.${DOMAIN}"
GEMINI_LINEAR_CLIENT_ID=
GEMINI_LINEAR_CLIENT_SECRET=
GEMINI_WEBHOOK_URL="https://linear-${GEMINI_PREFIX}.${DOMAIN}/webhook"
GEMINI_LINEAR_WEBHOOK_SECRET=
GEMINI_ARGS_TEMPLATE="-p {{PROMPT}} --approval-mode auto_edit --skip-trust"
GEMINI_BIN="${HOME}/.nvm/current/bin/gemini"
GEMINI_LAUNCH_MODE=warp
GEMINI_KV_NAMESPACE_ID=

TRAE_PREFIX=trae
TRAE_HOST="${TRAE_PREFIX}-agent.${DOMAIN}"
TRAE_LINEAR_CLIENT_ID=
TRAE_LINEAR_CLIENT_SECRET=
TRAE_WEBHOOK_URL="https://linear-${TRAE_PREFIX}.${DOMAIN}/webhook"
TRAE_LINEAR_WEBHOOK_SECRET=
TRAE_ARGS_TEMPLATE="chat --reuse-window --maximize {{PROMPT}}"
TRAE_BIN=/usr/local/bin/trae
TRAE_KV_NAMESPACE_ID=

CHATGPT_PREFIX=chatgpt
CHATGPT_HOST="${CHATGPT_PREFIX}-agent.${DOMAIN}"
CHATGPT_LINEAR_CLIENT_ID=
CHATGPT_LINEAR_CLIENT_SECRET=
CHATGPT_WEBHOOK_URL="https://linear-${CHATGPT_PREFIX}.${DOMAIN}/webhook"
CHATGPT_LINEAR_WEBHOOK_SECRET=
CHATGPT_KV_NAMESPACE_ID=

MOCK_PREFIX=mock
MOCK_HOST="${MOCK_PREFIX}-agent.${DOMAIN}"
MOCK_WEBHOOK_URL="https://linear-${MOCK_PREFIX}.${DOMAIN}/webhook"
MOCK_LINEAR_CLIENT_ID=
MOCK_LINEAR_CLIENT_SECRET=
MOCK_LINEAR_WEBHOOK_SECRET=
MOCK_KV_NAMESPACE_ID=





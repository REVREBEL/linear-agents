{
  "schemaVersion": 1,
  "agents": [
    {
      "id": "antigravity",
      "role": "coding",
      "provider": "antigravity",
      "packageDir": "agents/coding/antigravity",
      "worker": {
        "directory": "linear-antigravity-worker",
        "config": "wrangler.jsonc",
        "serviceTemplate": "linear-antigravity-agent",
        "prefixEnv": "ANTIGRAVITY_PREFIX",
        "kvEnv": "ANTIGRAVITY_KV_NAMESPACE_ID",
        "durableObject": "DELIVERY_COORDINATOR"
      },
      "execution": {
        "runtime": "agy",
        "host": "configurable"
      },
      "linear": {
        "appIdentity": "antigravity",
        "credentialPrefix": "ANTIGRAVITY"
      }
    },
    {
      "id": "chatgpt",

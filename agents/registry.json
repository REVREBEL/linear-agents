{
  "schemaVersion": 2,
  "agents": [
    {
      "id": "antigravity",
      "role": "coding",
      "provider": "antigravity",
      "packageDir": "agents/coding/antigravity",
      "worker": {
        "directory": "linear-antigravity-worker",
        "config": "wrangler.jsonc",
        "serviceTemplate": "linear-antigravity-agent",
        "prefixEnv": "ANTIGRAVITY_PREFIX",
        "kvEnv": "ANTIGRAVITY_KV_NAMESPACE_ID",
        "durableObject": "DELIVERY_COORDINATOR"
      },
      "execution": {
        "runtime": "agy",
        "host": "configurable"
      },
      "linear": {
        "appIdentity": "antigravity",
        "credentialPrefix": "ANTIGRAVITY"
      },
      "profile": {
        "displayName": "Antigravity Headless Runner",
        "kind": "cli_agent",
        "model": {
          "selection": "runtime",
          "id": "gemini-2.5-pro",
          "provider": "Google"
        },
        "taxonomy": {
          "agent_type": "Goal-based",
          "domain": "Full-stack software engineering and refactoring",
          "top_skills": [
            "Typescript / Node.js",
            "Automated test generation",
            "Cloudflare Workers & Durable Objects",
            "Python backend refactoring"
          ]
        },
        "routing": {
          "complexity_tier": "High",
          "semantic_description": "Autonomous code implementation, multi-file edits, bug fixes, and test authoring directly in project workspace.",
          "supported_intents": [
            "implement_feature",
            "fix_bug",
            "generate_tests",
            "code_refactor"
          ],
          "task_ratings": {
            "feature_implementation": {
              "score": 4.8,
              "source": "user_supplied"
            },
            "refactoring": {
              "score": 4.7,
              "source": "user_supplied"
            },
            "code_review": {
              "score": 3.5,
              "source": "user_supplied"
            }
          }
        }
      },
      "runtimeContract": {
        "transport": "headless_cli",
        "executionHost": "local_mac_bridge",
        "executable": {
          "binaryEnv": "AGY_BIN",
          "argv": [
            "-p",
            "{{PROMPT}}",
            "--conversation",
            "{{CONVERSATION_ID}}"
          ]
        },
        "workspaceRootEnv": "WORKSPACE_ROOT",
        "sessionContinuityFlag": "--conversation <conversation_id>",
        "linearBridge": {
          "workerHost": "linear-antigravity.revrebel.io",
          "tunnelHost": "antigravity-agent.revrebel.io",
          "supportedEvents": [
            "session_created",
            "session_prompted"
          ],
          "completionMode": "worker_callback"
        },
        "quotaPolicy": {
          "resumable": true,
          "defaultRetryDelayMs": 7200000,
          "maxRetryAttempts": 3,
          "exhaustionPattern": "RESOURCE_EXHAUSTED|Individual quota reached"
        }
      },
      "executionPolicy": {
        "autonomy_level": "Executor",
        "memory_scope": "session_isolated",
        "permissions": {
          "sourceWrite": true,
          "directoryMoves": true,
          "gitCommit": true,
          "gitPush": false,
          "autoMerge": false,
          "deployment": false
        },
        "security": {
          "blast_radius": "Medium",
          "credential_model": "ephemeral_session",
          "envStripPatterns": [
            "BRIDGE_SHARED_SECRET",
            "LINEAR_API_KEY",
            "LINEAR_ACCESS_TOKEN"
          ],
          "mcpToolAllowlist": [
            "github/list_commits"
          ],
          "handoff_targets": [
            "chatgpt-playwright",
            "human_supervisor"
          ]
        }
      }
    },

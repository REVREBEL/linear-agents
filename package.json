{
  "name": "linear-agents",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "linear-antigravity-worker",
    "linear-chatgpt-worker",
    "linear-gemini-worker",
    "linear-trae-worker",
    "linear-mock-worker"
  ],
  "scripts": {
    "test": "node --test linear-agent-bridge/*.test.mjs",
    "types": "node scripts/workspace-command.mjs types",
    "dev": "node scripts/workspace-command.mjs dev",
    "deploy": "node scripts/workspace-command.mjs deploy",
    "setup": "node scripts/workspace-command.mjs install",
    "setup:auto-launch": "bash scripts/macos/install-launchagent.sh",
    "terraform": "bash scripts/with-env.sh terraform",
    "terraform:init": "bash scripts/with-env.sh terraform init",
    "terraform:validate": "bash scripts/with-env.sh terraform validate",
    "terraform:plan": "bash scripts/with-env.sh terraform plan -out=linear.tfplan",
    "terraform:fmt": "bash scripts/with-env.sh terraform fmt -check",
    "terraform:apply-plan": "bash scripts/with-env.sh terraform apply linear.tfplan",
    "terraform:get-ids": "bash scripts/get-terraform-ids.sh",
    "linear:projects": "bash scripts/with-env.sh linear-projects",
    "chatgpt:playwright": "node scripts/chatgpt-playwright/handoff-test.mjs",
    "mock:agent": "bash scripts/with-env.sh mock-agent"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.24.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260701.1": true,
    "fsevents@2.3.3": true
  }
}

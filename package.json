{
  "name": "linear-agents",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "linear-antigravity-worker",
    "linear-chatgpt-worker",
    "linear-chatgpt-cli-worker",
    "linear-gemini-worker",
    "linear-trae-worker",
    "linear-mock-worker"
  ],
  "scripts": {
    "types": "node scripts/workspace-command.mjs types",
    "dev": "node scripts/workspace-command.mjs dev",
    "deploy": "node scripts/workspace-command.mjs deploy",
    "setup": "node scripts/workspace-command.mjs install",
    "terraform": "bash scripts/with-env.sh terraform",
    "terraform:init": "bash scripts/with-env.sh terraform init",
    "terraform:validate": "bash scripts/with-env.sh terraform validate",
    "terraform:plan": "bash scripts/with-env.sh terraform plan -out=linear.tfplan",
    "terraform:fmt": "bash scripts/with-env.sh terraform fmt -check",
    "terraform:apply-plan": "bash scripts/with-env.sh terraform apply linear.tfplan",
    "terraform:get-ids": "bash scripts/get-terraform-ids.sh",
    "linear:projects": "bash scripts/with-env.sh linear-projects",
    "chatgpt:playwright": "node scripts/chatgpt-playwright/handoff-test.mjs",
    "mock:agent": "bash scripts/with-env.sh mock-agent",
    "mock:submit": "bash scripts/with-env.sh mock-submit",
    "mock:end": "bash scripts/with-env.sh mock-end",
    "setup:kv": "node scripts/workspace-command.mjs kv",
    "bridge:load": "bash scripts/bridge.sh load",
    "bridge:unload": "bash scripts/bridge.sh unload",
    "bridge:restart": "bash scripts/bridge.sh restart",
    "bridge:status": "bash scripts/bridge.sh status",
    "bridge:doctor": "bash scripts/bridge.sh doctor",
    "bridge:check-trae-routes": "node scripts/check-trae-callbacks.mjs",
    "bridge:test": "node --test scripts/platform-scripts.test.mjs linear-agent-bridge/*.test.mjs scripts/agent-registry.test.mjs",
    "bridge:macos-setup": "bash scripts/macos/install-launchagent.sh",
    "log:messages": "npx wrangler tail linear-mock-agent --format pretty",
    "typecheck": "node scripts/workspace-typecheck.mjs",
    "test:reliability": "node --test scripts/platform-scripts.test.mjs scripts/oauth-errors.test.mjs scripts/check-trae-callbacks.test.mjs scripts/worker-webhook.test.mjs scripts/macos/chatgpt-shortcuts/review-handoff.test.mjs agents/coding/gemma/inventory.test.mjs agents/coding/gemma/dev-tools.test.mjs agents/coding/gemma/provider-key.test.mjs integrations/litellm/agent-runtime.test.mjs linear-agent-bridge/*.test.mjs scripts/agent-registry.test.mjs",
    "bridge:setup": "bash scripts/platform-setup.sh",
    "bridge:linux-setup": "bash scripts/linux/install-systemd.sh",
    "bridge:linux-publisher-setup": "bash scripts/linux/install-github-event-publisher.sh",
    "litellm:start": "pm2 start .config/litellm/ecosystem.config.js",
    "litellm:stop": "pm2 stop litellm",
    "litellm:restart": "pm2 restart litellm",
    "litellm:reload": "pm2 restart .config/litellm/ecosystem.config.js",
    "litellm:delete": "pm2 delete litellm",
    "litellm:status": "pm2 describe litellm",
    "litellm:logs": "pm2 logs litellm",
    "litellm:save": "pm2 save",
    "registry:validate": "node scripts/validate-agent-registry.mjs"
  },
  "devDependencies": {
    "@openrouter/agent": "^1.0.1",
    "typescript": "^7.0.0",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "volta": {
    "node": "26.13.0"
  }
}

/** @format */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "linear-chatgpt-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
	"workers_dev": false,
	"preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "LINEAR_DATA",
      "id": "${CHATGPT_KV_NAMESPACE_ID}",
    },
  ],
  "vars": {
    "SERVICE_NAME": "linear-${CHATGPT_PREFIX}-agent",
    "LINEAR_REDIRECT_URI": "https://linear-${CHATGPT_PREFIX}.${DOMAIN}/oauth/callback",
    "LINEAR_SCOPES": "read,write,app:assignable,app:mentionable",
    "BRIDGE_URL": "https://${CHATGPT_PREFIX}-agent.${DOMAIN}/jobs"
  },
}

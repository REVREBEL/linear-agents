/** @format */

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linear-gemini-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [
    {
      "binding": "LINEAR_DATA",
      "id": "744a012bd4df4316b8cecfb886c3bc48",
    }
  ],
  "vars": {
    "SERVICE_NAME": "linear-gemini-agent", 
    "LINEAR_REDIRECT_URI": "https://linear-gemini.revrebel.io/oauth/callback",
    "LINEAR_SCOPES": "read,write,app:assignable,app:mentionable",
    "BRIDGE_URL": "https://gemini-agent.revrebel.io/jobs"
  }
}
